<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 的父 POM：统一管理依赖版本和插件配置（版本选择见 ADR-0002） -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>cn.edu.fudan.spacewise</groupId>
    <artifactId>spacewise-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Spacewise</name>

    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- 每个服务是一个子模块；在根目录执行 mvn verify 会构建并测试全部模块 -->
    <modules>
        <module>services/seat-service</module>
    </modules>
</project>
