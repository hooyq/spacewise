<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 的父 POM：统一管理依赖版本和插件配置（版本选择见 ADR-0002） -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>cn.edu.fudan.spacewise</groupId>
    <artifactId>spacewise-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Spacewise</name>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <!-- 必须与 Spring Boot 版本配套：2025.0.x 对应 Boot 3.5（ADR-0005） -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>
    </properties>

    <!-- Spring Boot 父 POM 未管理的依赖，在这里统一版本；子模块引用时不写版本 -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud 各组件的版本清单（目前只有网关用到） -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 统一错误响应与全局异常处理（ADR-0006） -->
            <dependency>
                <groupId>cn.edu.fudan.spacewise</groupId>
                <artifactId>web-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- dao 层（ADR-0004） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 每个服务是一个子模块；在根目录执行 mvn verify 会构建并测试全部模块 -->
    <modules>
        <!-- 公共库（不是服务）：被各服务依赖，改动须组内评审 -->
        <module>libs/web-common</module>
        <module>services/seat-service</module>
        <module>services/room-service</module>
        <module>services/repair-service</module>
        <module>services/platform-service</module>
        <module>services/gateway</module>
    </modules>
</project>
